  "assessments": [
    {
      "id": "basic-marking",
      "title": "1. Basic marking test",
      "subtitle": "MC, short, long and multi-point marking",
      "attachSignoff": false,
      "questions": [],
      "questionGroups": [],
      "blocks": [
        {
          "type": "group",
          "id": "basics",
          "group": {
            "label": "Basic questions",
            "title": "Check normal marking",
            "intro": "Use the answer key supplied in the test pack."
          },
          "questions": [
            {
              "id": "colour",
              "part": "A",
              "text": "Select the test colour.",
              "type": "mc",
              "shuffleOptions": false,
              "maxPoints": 1,
              "options": [
                "Red",
                "Blue",
                "Green"
              ],
              "rubric": [
                {
                  "points": 1,
                  "check": "^Blue$",
                  "flags": "i"
                }
              ]
            },
            {
              "id": "material",
              "part": "B",
              "text": "Type the test material.",
              "hint": "The expected word is steel.",
              "type": "short",
              "maxPoints": 1,
              "rubric": [
                {
                  "points": 1,
                  "check": "\\bsteel\\b",
                  "flags": "i"
                }
              ]
            },
            {
              "id": "process",
              "part": "C",
              "text": "Write a sentence containing both test actions.",
              "hint": "Use both measure and mark.",
              "type": "long",
              "maxPoints": 2,
              "rubric": [
                {
                  "points": 1,
                  "check": "\\bmeasur(?:e|ed|ing)\\b",
                  "flags": "i"
                },
                {
                  "points": 1,
                  "check": "\\bmark(?:ed|ing)?\\b",
                  "flags": "i"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
