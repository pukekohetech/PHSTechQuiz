{
  "schemaVersion": 3,
  "_testOnly": true,
  "_testPurpose": "Tests a conditional Yes branch, hidden-answer clearing, tracker totals, save/load and changing the controller from Yes back to No.",
  "questionSet": {
    "id": "us990003-test-conditional",
    "label": "US 990003 - TEST ONLY - Conditional questions",
    "title": "TEST ONLY - Conditional question branches",
    "number": "990003",
    "version": "v1",
    "credits": 0,
    "standardType": "internal",
    "evidenceTracker": {
      "kicker": "Test progress",
      "title": "Conditional branch test",
      "intro": "Select Yes to reveal three extra questions. Change back to No to make sure they disappear and are no longer counted.",
      "items": [
        {
          "id": "conditional",
          "type": "groups",
          "assessmentId": "conditional-test",
          "blockIds": [
            "start",
            "problem-found",
            "finish"
          ],
          "label": "Conditional assessment",
          "require": "rubric"
        }
      ]
    }
  },
  "assessments": [
    {
      "id": "conditional-test",
      "title": "1. Conditional branch test",
      "subtitle": "Yes reveals extra questions",
      "attachSignoff": false,
      "questions": [],
      "questionGroups": [],
      "blocks": [
        {
          "type": "group",
          "id": "start",
          "group": {
            "label": "Start",
            "title": "Start the test"
          },
          "questions": [
            {
              "id": "project",
              "part": "A",
              "text": "Type the project name.",
              "hint": "Use Test Project.",
              "type": "short",
              "maxPoints": 1,
              "rubric": [
                {
                  "points": 1,
                  "check": "\\btest project\\b",
                  "flags": "i"
                }
              ]
            }
          ]
        },
        {
          "type": "conditional",
          "id": "problem-found",
          "group": {
            "label": "Conditional branch",
            "title": "Was there a problem?",
            "intro": "Choose Yes first to test the revealed questions.",
            "reminder": "Then try changing it back to No."
          },
          "question": {
            "id": "problem_choice",
            "part": "A",
            "text": "Did the test item have a problem?",
            "type": "mc",
            "shuffleOptions": false,
            "maxPoints": 1,
            "options": [
              "No",
              "Yes"
            ],
            "rubric": [
              {
                "points": 1,
                "check": "^(?:No|Yes)$",
                "flags": "i"
              }
            ]
          },
          "showWhen": {
            "value": "Yes"
          },
          "clearWhenHidden": true,
          "closedMessage": "No problem to report.",
          "questions": [
            {
              "id": "problem",
              "part": "B",
              "text": "What was the problem?",
              "hint": "Use cracked, loose, broken or failed.",
              "type": "short",
              "maxPoints": 1,
              "rubric": [
                {
                  "points": 1,
                  "check": "\\b(?:cracked|loose|broken|failed)\\b",
                  "flags": "i"
                }
              ]
            },
            {
              "id": "fix",
              "part": "C",
              "text": "What did you do to fix it?",
              "hint": "Use repair, replace, adjust, change or fix.",
              "type": "long",
              "maxPoints": 1,
              "rubric": [
                {
                  "points": 1,
                  "check": "\\b(?:repair(?:ed)?|replace(?:d)?|adjust(?:ed)?|change(?:d)?|fix(?:ed)?)\\b",
                  "flags": "i"
                }
              ]
            },
            {
              "id": "retest",
              "part": "D",
              "text": "How did you check the fix?",
              "hint": "Use retest, tested again or checked again.",
              "type": "long",
              "maxPoints": 1,
              "rubric": [
                {
                  "points": 1,
                  "check": "\\b(?:retest(?:ed)?|tested again|checked again)\\b",
                  "flags": "i"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "id": "finish",
          "group": {
            "label": "Finish",
            "title": "Finish the test"
          },
          "questions": [
            {
              "id": "final",
              "part": "A",
              "text": "Type COMPLETE to finish.",
              "type": "short",
              "maxPoints": 1,
              "rubric": [
                {
                  "points": 1,
                  "check": "^COMPLETE$",
                  "flags": "i"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
